+//! SDL keyboard events to Ruffle key descriptors.
+
+use ruffle_core::events::{KeyDescriptor, KeyLocation, LogicalKey, NamedKey, PhysicalKey};
+use sdl2::keyboard::{Keycode, Mod, Scancode};
+
+pub fn key_descriptor(
+    scancode: Option<Scancode>,
+    keycode: Option<Keycode>,
+    keymod: Mod,
+) -> KeyDescriptor {
+    let physical_key = scancode.map(physical).unwrap_or(PhysicalKey::Unknown);
+    KeyDescriptor {
+        physical_key,
+        logical_key: keycode
+            .map(|k| logical(k, keymod))
+            .unwrap_or(LogicalKey::Unknown),
+        key_location: location(physical_key),
+    }
+}
+
+fn location(key: PhysicalKey) -> KeyLocation {
+    use PhysicalKey as P;
+    match key {
+        P::ShiftLeft | P::ControlLeft | P::AltLeft | P::SuperLeft => KeyLocation::Left,
+        P::ShiftRight | P::ControlRight | P::AltRight | P::SuperRight => KeyLocation::Right,
+        P::NumLock
+        | P::NumpadDivide
+        | P::NumpadMultiply
+        | P::NumpadSubtract
+        | P::NumpadAdd
+        | P::NumpadEnter
+        | P::NumpadDecimal
+        | P::NumpadComma
+        | P::Numpad0
+        | P::Numpad1
+        | P::Numpad2
+        | P::Numpad3
+        | P::Numpad4
+        | P::Numpad5
+        | P::Numpad6
+        | P::Numpad7
+        | P::Numpad8
+        | P::Numpad9 => KeyLocation::Numpad,
+        _ => KeyLocation::Standard,
+    }
+}
+
+fn logical(keycode: Keycode, keymod: Mod) -> LogicalKey {
+    use NamedKey as N;
+    let named = match keycode {
+        Keycode::LALT | Keycode::RALT => N::Alt,
+        Keycode::LCTRL | Keycode::RCTRL => N::Control,
+        Keycode::LSHIFT | Keycode::RSHIFT => N::Shift,
+        Keycode::LGUI | Keycode::RGUI => N::Super,
+        Keycode::CAPSLOCK => N::CapsLock,
+        Keycode::NUMLOCKCLEAR => N::NumLock,
+        Keycode::SCROLLLOCK => N::ScrollLock,
+        Keycode::RETURN | Keycode::KP_ENTER => N::Enter,
+        Keycode::TAB => N::Tab,
+        Keycode::DOWN => N::ArrowDown,
+        Keycode::LEFT => N::ArrowLeft,
+        Keycode::RIGHT => N::ArrowRight,
+        Keycode::UP => N::ArrowUp,
+        Keycode::END => N::End,
+        Keycode::HOME => N::Home,
+        Keycode::PAGEDOWN => N::PageDown,
+        Keycode::PAGEUP => N::PageUp,
+        Keycode::BACKSPACE => N::Backspace,
+        Keycode::DELETE => N::Delete,
+        Keycode::INSERT => N::Insert,
+        Keycode::ESCAPE => N::Escape,
+        Keycode::PAUSE => N::Pause,
+        Keycode::PRINTSCREEN => N::PrintScreen,
+        Keycode::APPLICATION => N::ContextMenu,
+        Keycode::F1 => N::F1,
+        Keycode::F2 => N::F2,
+        Keycode::F3 => N::F3,
+        Keycode::F4 => N::F4,
+        Keycode::F5 => N::F5,
+        Keycode::F6 => N::F6,
+        Keycode::F7 => N::F7,
+        Keycode::F8 => N::F8,
+        Keycode::F9 => N::F9,
+        Keycode::F10 => N::F10,
+        Keycode::F11 => N::F11,
+        Keycode::F12 => N::F12,
+        _ => {
+            // Printable keys: SDL keycodes are the unshifted character.
+            let code = keycode.into_i32();
+            return match char::from_u32(code as u32) {
+                Some(c) if (' '..='~').contains(&c) => {
+                    let shift = keymod.intersects(Mod::LSHIFTMOD | Mod::RSHIFTMOD);
+                    let caps = keymod.contains(Mod::CAPSMOD);
+                    LogicalKey::Character(if c.is_ascii_alphabetic() && (shift ^ caps) {
+                        c.to_ascii_uppercase()
+                    } else {
+                        c
+                    })
+                }
+                _ => LogicalKey::Unknown,
+            };
+        }
+    };
+    LogicalKey::Named(named)
+}
+
+fn physical(scancode: Scancode) -> PhysicalKey {
+    use PhysicalKey as P;
+    use Scancode as S;
+    match scancode {
+        S::Grave => P::Backquote,
+        S::Num0 => P::Digit0,
+        S::Num1 => P::Digit1,
+        S::Num2 => P::Digit2,
+        S::Num3 => P::Digit3,
+        S::Num4 => P::Digit4,
+        S::Num5 => P::Digit5,
+        S::Num6 => P::Digit6,
+        S::Num7 => P::Digit7,
+        S::Num8 => P::Digit8,
+        S::Num9 => P::Digit9,
+        S::Minus => P::Minus,
+        S::Equals => P::Equal,
+        S::A => P::KeyA,
+        S::B => P::KeyB,
+        S::C => P::KeyC,
+        S::D => P::KeyD,
+        S::E => P::KeyE,
+        S::F => P::KeyF,
+        S::G => P::KeyG,
+        S::H => P::KeyH,
+        S::I => P::KeyI,
+        S::J => P::KeyJ,
+        S::K => P::KeyK,
+        S::L => P::KeyL,
+        S::M => P::KeyM,
+        S::N => P::KeyN,
+        S::O => P::KeyO,
+        S::P => P::KeyP,
+        S::Q => P::KeyQ,
+        S::R => P::KeyR,
+        S::S => P::KeyS,
+        S::T => P::KeyT,
+        S::U => P::KeyU,
+        S::V => P::KeyV,
+        S::W => P::KeyW,
+        S::X => P::KeyX,
+        S::Y => P::KeyY,
+        S::Z => P::KeyZ,
+        S::LeftBracket => P::BracketLeft,
+        S::RightBracket => P::BracketRight,
+        S::Backslash => P::Backslash,
+        S::Semicolon => P::Semicolon,
+        S::Apostrophe => P::Quote,
+        S::NonUsBackslash => P::IntlBackslash,
+        S::Comma => P::Comma,
+        S::Period => P::Period,
+        S::Slash => P::Slash,
+        S::Backspace => P::Backspace,
+        S::Tab => P::Tab,
+        S::CapsLock => P::CapsLock,
+        S::Return => P::Enter,
+        S::LShift => P::ShiftLeft,
+        S::RShift => P::ShiftRight,
+        S::LCtrl => P::ControlLeft,
+        S::RCtrl => P::ControlRight,
+        S::LGui => P::SuperLeft,
+        S::RGui => P::SuperRight,
+        S::LAlt => P::AltLeft,
+        S::RAlt => P::AltRight,
+        S::Space => P::Space,
+        S::Application => P::ContextMenu,
+        S::Insert => P::Insert,
+        S::Delete => P::Delete,
+        S::Home => P::Home,
+        S::End => P::End,
+        S::PageUp => P::PageUp,
+        S::PageDown => P::PageDown,
+        S::Up => P::ArrowUp,
+        S::Left => P::ArrowLeft,
+        S::Down => P::ArrowDown,
+        S::Right => P::ArrowRight,
+        S::NumLockClear => P::NumLock,
+        S::KpDivide => P::NumpadDivide,
+        S::KpMultiply => P::NumpadMultiply,
+        S::KpMinus => P::NumpadSubtract,
+        S::KpPlus => P::NumpadAdd,
+        S::KpEnter => P::NumpadEnter,
+        S::KpPeriod => P::NumpadDecimal,
+        S::KpComma => P::NumpadComma,
+        S::Kp0 => P::Numpad0,
+        S::Kp1 => P::Numpad1,
+        S::Kp2 => P::Numpad2,
+        S::Kp3 => P::Numpad3,
