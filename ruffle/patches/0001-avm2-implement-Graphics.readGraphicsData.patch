+/// A fill or stroke path of a [`Drawing`], as exposed by [`Drawing::data_paths`].
+pub enum DrawingDataPath<'a> {
+    Fill {
+        style: &'a FillStyle,
+        rule: FillRule,
+        commands: &'a [DrawCommand],
+    },
+    Line {
+        style: &'a LineStyle,
+        commands: &'a [DrawCommand],
+    },
+}
+
 #[derive(Debug, Clone)]
 struct DrawingFill {
     style: FillStyle,
@@ -447,6 +477,25 @@ struct DrawingLine {
