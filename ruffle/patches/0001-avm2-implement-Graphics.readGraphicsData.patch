 }
 
+impl DrawingFill {
+    fn data_path(&self) -> DrawingDataPath<'_> {
+        DrawingDataPath::Fill {
+            style: &self.style,
+            rule: self.rule,
+            commands: &self.commands,
+        }
+    }
+}
+
+impl DrawingLine {
+    fn data_path(&self) -> DrawingDataPath<'_> {
+        DrawingDataPath::Line {
+            style: &self.style,
+            commands: &self.commands,
+        }
+    }
+}
