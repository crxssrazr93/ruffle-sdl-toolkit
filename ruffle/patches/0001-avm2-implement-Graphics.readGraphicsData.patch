+    /// Read-only view of the drawing's fill and stroke paths, in drawing order
+    /// (used by `Graphics.readGraphicsData`).
+    pub fn data_paths(&self) -> Vec<DrawingDataPath<'_>> {
+        let mut out: Vec<DrawingDataPath<'_>> = self
+            .paths
+            .iter()
+            .map(|path| match path {
+                DrawingPath::Fill(f) => f.data_path(),
+                DrawingPath::Line(l) => l.data_path(),
+            })
+            .collect();
+        out.extend(self.current_fill.iter().map(DrawingFill::data_path));
+        out.extend(self.pending_lines.iter().map(DrawingLine::data_path));
+        out.extend(self.current_line.iter().map(DrawingLine::data_path));
+        out
+    }
+
     fn mark_dirty(&mut self) {
         self.is_empty = false;
         self.render_handle.take();
@@ -433,6 +450,19 @@ impl BitmapSource for Drawing {
