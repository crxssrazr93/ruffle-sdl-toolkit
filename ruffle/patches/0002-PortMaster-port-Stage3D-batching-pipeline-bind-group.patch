+/// Opt-in performance log for the PortMaster port: set RUFFLE_FPS_LOG=1 to print, every two
+/// seconds, how many frames were run and rendered and how long each took on average.
+#[cfg(not(target_family = "wasm"))]
+mod port_fps {
+    use std::sync::{Mutex, OnceLock};
+    use std::time::{Duration, Instant};
+
+    struct Stats {
+        start: Instant,
+        frames: u32,
+        renders: u32,
+        logic: Duration,
+        render: Duration,
+    }
+
+    static STATS: Mutex<Option<Stats>> = Mutex::new(None);
+
+    fn enabled() -> bool {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        *ENABLED.get_or_init(|| std::env::var_os("RUFFLE_FPS_LOG").is_some())
+    }
+
+    pub struct Timer(Option<(Instant, bool)>);
+
+    impl Timer {
+        pub fn new(render: bool) -> Self {
+            Self(enabled().then(|| (Instant::now(), render)))
+        }
+    }
+
+    impl Drop for Timer {
+        fn drop(&mut self) {
+            let Some((t0, render)) = self.0 else { return };
+            let now = Instant::now();
+            let mut guard = STATS.lock().unwrap();
+            let s = guard.get_or_insert_with(|| Stats {
+                start: now,
+                frames: 0,
+                renders: 0,
+                logic: Duration::ZERO,
+                render: Duration::ZERO,
+            });
+            if render {
+                s.renders += 1;
+                s.render += now - t0;
+            } else {
+                s.frames += 1;
+                s.logic += now - t0;
+            }
+            let span = now - s.start;
+            if span >= Duration::from_secs(2) {
+                let secs = span.as_secs_f64();
+                tracing::info!(
+                    "port_fps: {:.1} frames/s ({:.1} ms logic), {:.1} renders/s ({:.1} ms render)",
+                    s.frames as f64 / secs,
+                    s.logic.as_secs_f64() * 1000.0 / s.frames.max(1) as f64,
+                    s.renders as f64 / secs,
+                    s.render.as_secs_f64() * 1000.0 / s.renders.max(1) as f64,
+                );
+                *guard = None;
+            }
+        }
+    }
+}
+
+#[cfg(target_family = "wasm")]
+mod port_fps {
+    pub struct Timer;
+    impl Timer {
+        pub fn new(_render: bool) -> Self {
+            Self
+        }
+    }
+}
