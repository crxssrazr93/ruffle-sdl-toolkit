@@ -0,0 +1,323 @@
+//! PortMaster port: memory accounting by category (`RUFFLE_MEMLOG=1`).
+//!
+//! Large allocations (BitmapData CPU pixels, textures, pooled render targets, shape meshes,
+//! sounds) carry a [`Tag`] that adds its size to a category while it lives. The front end samples
+//! the totals together with the process RSS (`ruffle_sdl`: a line per second, the biggest items at
+//! the RSS peak). Off by default: a disabled `Tag` is inert and costs one branch.
+
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicI64, AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+#[derive(Copy, Clone, Debug, PartialEq, Eq, Hash)]
+pub enum Cat {
+    /// CPU pixel buffers of BitmapData objects (`BitmapRawData::pixels`).
+    CpuPixels,
+    /// Textures of BitmapData objects (`register_bitmap` from a BitmapData).
+    BitmapTex,
+    /// Textures of SWF-embedded bitmaps and other `register_bitmap` callers.
+    SwfBitmapTex,
+    /// cacheAsBitmap textures (`create_empty_texture`).
+    CabTex,
+    /// Pooled render targets (frame, resolve, blend and stencil buffers).
+    PoolTex,
+    /// Shape meshes (vertex, index, uniform buffers and gradient textures) tessellated while
+    /// rendering the stage.
+    Mesh,
+    /// Shape meshes first tessellated inside a `BitmapData.draw`.
+    MeshDraw,
+    /// Registered sounds (compressed data copied into the mixer).
+    Sound,
+    /// Uncompressed SWF data.
+    Swf,
+    /// Parsed library characters kept for the life of the movie (approximate): shape records of
+    /// DefineShape characters, compressed bitmap data.
+    Library,
+}
+
+pub const CATS: [Cat; 10] = [
+    Cat::CpuPixels,
+    Cat::BitmapTex,
+    Cat::SwfBitmapTex,
+    Cat::CabTex,
+    Cat::PoolTex,
+    Cat::Mesh,
+    Cat::MeshDraw,
+    Cat::Sound,
+    Cat::Swf,
+    Cat::Library,
+];
+
+impl Cat {
+    pub fn name(self) -> &'static str {
+        match self {
+            Cat::CpuPixels => "cpu_px",
+            Cat::BitmapTex => "bmd_tex",
+            Cat::SwfBitmapTex => "swf_tex",
+            Cat::CabTex => "cab_tex",
+            Cat::PoolTex => "pool_tex",
+            Cat::Mesh => "mesh",
+            Cat::MeshDraw => "mesh_draw",
+            Cat::Sound => "sound",
+            Cat::Swf => "swf",
+            Cat::Library => "library",
+        }
+    }
+
+    fn index(self) -> usize {
+        self as usize
+    }
+}
+
+const N: usize = CATS.len();
+
+#[expect(clippy::declare_interior_mutable_const)]
+const ZERO: AtomicI64 = AtomicI64::new(0);
+static BYTES: [AtomicI64; N] = [ZERO; N];
+static COUNT: [AtomicI64; N] = [ZERO; N];
+static PEAK: [AtomicI64; N] = [ZERO; N];
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+/// Readbacks of GPU results into CPU pixels: count and bytes.
+static READBACKS: AtomicI64 = AtomicI64::new(0);
+static READBACK_BYTES: AtomicI64 = AtomicI64::new(0);
+/// Gauges set by the front end (gc object count).
+static GC_COUNT: AtomicI64 = AtomicI64::new(0);
+
+struct Item {
+    cat: Cat,
+    bytes: u64,
+    desc: String,
+    born: f32,
+}
+
+fn items() -> &'static Mutex<HashMap<u64, Item>> {
+    static ITEMS: OnceLock<Mutex<HashMap<u64, Item>>> = OnceLock::new();
+    ITEMS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+fn start() -> Instant {
+    static START: OnceLock<Instant> = OnceLock::new();
+    *START.get_or_init(Instant::now)
+}
+
+/// `RUFFLE_MEMLOG` is set (and not "0").
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var("RUFFLE_MEMLOG").is_ok_and(|v| !v.is_empty() && v != "0");
+        if on {
+            start();
+        }
+        on
+    })
+}
+
+thread_local! {
+    static CTX: Cell<&'static str> = const { Cell::new("") };
+}
+
+/// What the current thread is doing ("bitmapdata", "bitmapdata.draw"); allocations made
+/// meanwhile are attributed to it. Restored when the guard drops.
+pub struct CtxGuard(&'static str);
+
+pub fn ctx(name: &'static str) -> CtxGuard {
+    CtxGuard(CTX.with(|c| c.replace(name)))
+}
+
+impl Drop for CtxGuard {
+    fn drop(&mut self) {
+        CTX.with(|c| c.set(self.0));
+    }
+}
+
+pub fn current_ctx() -> &'static str {
+    CTX.with(|c| c.get())
+}
+
+/// Adds `bytes` to `cat` while it lives.
+#[derive(Debug, Default)]
+pub struct Tag {
+    id: u64,
+    cat: Option<Cat>,
+    bytes: u64,
+}
+
+impl Tag {
+    pub const NONE: Tag = Tag {
+        id: 0,
+        cat: None,
+        bytes: 0,
+    };
+
+    pub fn new(cat: Cat, bytes: u64, desc: impl FnOnce() -> String) -> Tag {
+        if !enabled() {
+            return Tag::NONE;
+        }
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        add(cat, bytes as i64, 1);
+        let born = start().elapsed().as_secs_f32();
+        if let Ok(mut items) = items().lock() {
+            items.insert(
+                id,
+                Item {
+                    cat,
+                    bytes,
+                    desc: desc(),
+                    born,
+                },
+            );
+        }
+        Tag {
+            id,
+            cat: Some(cat),
+            bytes,
+        }
+    }
+
+    pub fn bytes(&self) -> u64 {
+        self.bytes
+    }
+
+    /// The tagged allocation changed size (0: freed, the item stays listed until the tag drops).
+    pub fn set_bytes(&mut self, bytes: u64) {
+        let Some(cat) = self.cat else { return };
+        add(cat, bytes as i64 - self.bytes as i64, 0);
+        self.bytes = bytes;
+        if let Ok(mut items) = items().lock()
+            && let Some(item) = items.get_mut(&self.id)
+        {
+            item.bytes = bytes;
+        }
+    }
+}
+
+impl Drop for Tag {
+    fn drop(&mut self) {
+        let Some(cat) = self.cat else { return };
+        add(cat, -(self.bytes as i64), -1);
+        if let Ok(mut items) = items().lock() {
+            items.remove(&self.id);
+        }
+    }
+}
+
+fn add(cat: Cat, bytes: i64, count: i64) {
+    let i = cat.index();
+    let now = BYTES[i].fetch_add(bytes, Ordering::Relaxed) + bytes;
+    COUNT[i].fetch_add(count, Ordering::Relaxed);
+    PEAK[i].fetch_max(now, Ordering::Relaxed);
+}
+
+/// Adds bytes that are never freed (sounds, SWF data) to `cat`.
+pub fn add_static(cat: Cat, bytes: u64, desc: impl FnOnce() -> String) {
+    if enabled() {
+        std::mem::forget(Tag::new(cat, bytes, desc));
+    }
+}
+
+/// A GPU result was read back into CPU pixels.
+pub fn readback(bytes: u64) {
+    if enabled() {
+        READBACKS.fetch_add(1, Ordering::Relaxed);
+        READBACK_BYTES.fetch_add(bytes as i64, Ordering::Relaxed);
+    }
+}
+
+pub fn set_gc_count(count: usize) {
+    GC_COUNT.store(count as i64, Ordering::Relaxed);
+}
+
+const MB: f64 = 1024.0 * 1024.0;
+
+/// Category totals in MB with counts: "cpu_px 123.4/56 bmd_tex ...".
+pub fn totals_line() -> String {
+    let mut s = String::new();
+    let mut sum = 0;
+    for cat in CATS {
+        let b = BYTES[cat.index()].load(Ordering::Relaxed);
+        sum += b;
+        s += &format!(
+            "{} {:.1}/{} ",
+            cat.name(),
+            b as f64 / MB,
+            COUNT[cat.index()].load(Ordering::Relaxed)
+        );
+    }
+    s += &format!(
+        "| sum {:.1} | readbacks {} ({:.1} MB) gc_objs {}",
+        sum as f64 / MB,
+        READBACKS.load(Ordering::Relaxed),
+        READBACK_BYTES.load(Ordering::Relaxed) as f64 / MB,
+        GC_COUNT.load(Ordering::Relaxed)
+    );
+    s
+}
+
+pub fn total_bytes() -> i64 {
+    CATS.iter()
+        .map(|c| BYTES[c.index()].load(Ordering::Relaxed))
+        .sum()
+}
+
+/// Per-category peaks.
+pub fn peaks_line() -> String {
+    CATS.iter()
+        .map(|c| {
+            format!(
+                "{} {:.1}",
+                c.name(),
+                PEAK[c.index()].load(Ordering::Relaxed) as f64 / MB
+            )
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// The `n` biggest live items of each category, plus counts by description for the rest.
+pub fn top_items(n: usize) -> String {
+    let Ok(items) = items().lock() else {
+        return String::new();
+    };
+    let mut out = String::new();
+    for cat in CATS {
+        let mut list: Vec<&Item> = items
+            .values()
+            .filter(|i| i.cat == cat && i.bytes > 0)
+            .collect();
+        if list.is_empty() {
+            continue;
+        }
+        list.sort_by_key(|i| std::cmp::Reverse(i.bytes));
+        let total: u64 = list.iter().map(|i| i.bytes).sum();
+        out += &format!(
+            "  [{}] {} items, {:.1} MB\n",
+            cat.name(),
+            list.len(),
+            total as f64 / MB
+        );
+        for item in list.iter().take(n) {
+            out += &format!(
+                "    {:8.2} MB  t={:6.1}s  {}\n",
+                item.bytes as f64 / MB,
+                item.born,
+                item.desc
+            );
+        }
+        if list.len() > n {
+            let rest: u64 = list.iter().skip(n).map(|i| i.bytes).sum();
+            out += &format!(
+                "    {:8.2} MB  in {} more\n",
+                rest as f64 / MB,
+                list.len() - n
+            );
+        }
+    }
+    out
+}
+
+/// Seconds since the first tagged allocation.
+pub fn elapsed() -> f32 {
+    start().elapsed().as_secs_f32()
+}
