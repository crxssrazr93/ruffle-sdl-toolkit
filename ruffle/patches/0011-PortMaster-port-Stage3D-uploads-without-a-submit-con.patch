+//! PortMaster port: queue submits and Stage3D render pass counters. With `PM_GPUSTAT` set they
+//! are logged every 2 s (target `pmgpu`, next to the upload / offscreen / readback line).
+
+use std::cell::RefCell;
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy)]
+pub enum C {
+    /// `queue.submit` calls (renderer and Stage3D)
+    Submit,
+    /// Command buffers passed to those submits
+    SubmitBuffers,
+    /// Command buffers queued for a later submit instead of submitted
+    Deferred,
+    /// `Context3D.present` calls
+    Present,
+    /// Stage3D render passes begun
+    Pass,
+    /// Stage3D draws recorded
+    Draw,
+    /// Stage3D pass ended early because a buffer used by the pass was uploaded to
+    BreakBuffer,
+    /// ... because a texture was copied into
+    BreakTexture,
+    /// ... because the uniform ring was full
+    BreakRing,
+}
+
+const N: usize = 9;
+const NAMES: [&str; N] = [
+    "submits",
+    "buffers",
+    "deferred",
+    "presents",
+    "s3d passes",
+    "s3d draws",
+    "breaks buffer",
+    "texture",
+    "ring",
+];
+
+thread_local! {
+    static S: RefCell<(Instant, [u64; N])> = RefCell::new((Instant::now(), [0; N]));
+}
+
+pub fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("PM_GPUSTAT").is_some())
+}
+
+pub fn add(c: C, n: u64) {
+    if !on() {
+        return;
+    }
+    S.with(|s| {
+        let mut s = s.borrow_mut();
+        s.1[c as usize] += n;
+        if s.0.elapsed() >= Duration::from_secs(2) {
+            let mut line = String::new();
+            for (i, name) in NAMES.iter().enumerate() {
+                if !line.is_empty() {
+                    line.push_str(", ");
+                }
+                line.push_str(&format!("{name} {}", s.1[i]));
+            }
+            tracing::info!(target: "pmgpu", "per 2s: {line}");
+            s.0 = Instant::now();
+            s.1 = [0; N];
+        }
+    });
+}
