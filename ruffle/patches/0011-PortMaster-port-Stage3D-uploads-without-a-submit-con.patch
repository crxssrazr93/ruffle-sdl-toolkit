+    /// PortMaster port (`RUFFLE_S3D_DEFER_UPLOAD`): queue what is recorded so far for the next
+    /// submit instead of submitting it. Draws still pending (`pending_pass`) stay pending: they
+    /// do not touch what was recorded before them. Our staging belt is only recalled in `flush`,
+    /// after a submit that took the queue.
+    fn defer(&mut self) {
+        if let Some(encoder) = self.buffer_command_encoder.take() {
+            self.buffer_staging_belt.finish();
+            self.descriptors.defer_command_buffer(encoder.finish());
+        }
+    }
