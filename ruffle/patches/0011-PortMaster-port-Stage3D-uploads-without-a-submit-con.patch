+    /// PortMaster port (`RUFFLE_S3D_MERGE_PASSES`): ends the pending pass early if it uses the
+    /// buffer or texture at `address` (which is about to be written to; the write is recorded
+    /// right away, so it would land before the pending draws).
+    fn end_pending_pass_if_uses(&mut self, address: usize, reason: crate::pmstat::C) {
+        if self
+            .pending_pass
+            .as_ref()
+            .is_some_and(|pass| pass.target == Some(address) || pass.uses.contains(&address))
+        {
+            crate::pmstat::add(reason, 1);
+            self.end_pending_pass();
+        }
+    }
+
+    /// PortMaster port: records the pending draws as one render pass, after one copy of the
+    /// program constants they use into the uniform ring.
+    fn end_pending_pass(&mut self) {
+        let Some(pass) = self.pending_pass.take() else {
+            return;
+        };
+        let encoder = frame_encoder(&mut self.buffer_command_encoder, &self.descriptors.device);
+        if let (Some(size), Some(ring)) = (
+            NonZeroU64::new(pass.uniforms.len() as u64),
+            self.current_pipeline.uniform_ring.as_ref(),
+        ) {
+            self.buffer_staging_belt
+                .write_buffer(encoder, ring, pass.uniform_base, size)
+                .copy_from_slice(&pass.uniforms);
+        }
+        encode_pending_pass(encoder, &pass);
+    }
+
+    /// PortMaster port: starts a pending pass on the current target, taking a pending clear
+    /// like `make_render_pass`.
+    fn begin_pending_pass(&mut self) {
+        let clear_color = self.clear_color.take();
+        let color_load = match clear_color {
+            Some(clear) if clear.mask & COLOR_MASK != 0 => wgpu::LoadOp::Clear(clear.rgb),
+            _ => wgpu::LoadOp::Load,
+        };
+        let depth_load = match clear_color {
+            Some(clear) if clear.mask & DEPTH_MASK != 0 => wgpu::LoadOp::Clear(clear.depth),
+            _ => wgpu::LoadOp::Load,
+        };
+        let stencil_load = match clear_color {
+            Some(clear) if clear.mask & STENCIL_MASK != 0 => wgpu::LoadOp::Clear(clear.stencil),
+            _ => wgpu::LoadOp::Load,
+        };
+        self.pending_pass = Some(PendingPass {
+            color_view: self.current_texture_view.clone().unwrap(),
+            resolve_view: self.current_texture_resolve_view.clone(),
+            depth_view: self.current_depth_texture_view.clone(),
+            color_load,
+            depth_load,
+            stencil_load,
+            size: self.current_texture_size.unwrap(),
+            target: self.current_target,
+            draws: Vec::new(),
+            uses: Vec::new(),
+            uniform_base: self.uniform_ring_cursor,
+            uniforms: Vec::new(),
+        });
+    }
+
+    /// PortMaster port: the ring offset of the current vertex (or fragment) constants, copying
+    /// them into the pending pass's uniform data if they changed since their last copy.
+    fn constants_at(&mut self, vertex: bool) -> u64 {
+        let (at, data) = if vertex {
+            (&mut self.vertex_constants_at, &self.vertex_constants)
+        } else {
+            (&mut self.fragment_constants_at, &self.fragment_constants)
+        };
+        if let Some(at) = *at {
+            return at;
+        }
+        let pass = self.pending_pass.as_mut().unwrap();
+        let offset = self.uniform_ring_cursor;
+        debug_assert_eq!(pass.uniform_base + pass.uniforms.len() as u64, offset);
+        pass.uniforms.extend_from_slice(data);
+        let padded = (data.len() as u64).next_multiple_of(self.uniform_align);
+        pass.uniforms
+            .resize((offset + padded - pass.uniform_base) as usize, 0);
+        self.uniform_ring_cursor = offset + padded;
+        *at = Some(offset);
+        offset
+    }
+
+    /// PortMaster port (`RUFFLE_S3D_MERGE_PASSES`): `drawTriangles` without a render pass of its
+    /// own: the draw joins the pending pass.
+    fn record_draw(
+        &mut self,
+        index_buffer: &IndexBufferWrapper,
+        indices: std::ops::Range<u32>,
+        draw: bool,
+    ) {
+        let align = self.uniform_align;
+        let needed = |at: Option<u64>, size: u64| {
+            if at.is_some() {
+                0
+            } else {
+                size.next_multiple_of(align)
+            }
+        };
+        let need = needed(self.vertex_constants_at, self.vertex_constants.len() as u64)
+            + needed(
+                self.fragment_constants_at,
+                self.fragment_constants.len() as u64,
+            );
+        if self.uniform_ring_cursor + need > current_pipeline::UNIFORM_RING_SIZE {
+            if self.pending_pass.is_some() {
+                crate::pmstat::add(crate::pmstat::C::BreakRing, 1);
+            }
+            self.end_pending_pass();
+            self.uniform_ring_cursor = 0;
+            self.vertex_constants_at = None;
+            self.fragment_constants_at = None;
+        }
+        if self.pending_pass.is_none() {
+            self.begin_pending_pass();
+        }
+        let offsets = [
+            self.constants_at(true) as u32,
+            self.constants_at(false) as u32,
+        ];
+
+        let scissor = if let Some(rect) = &self.scissor_rectangle {
+            let current_size = self.current_texture_size.unwrap();
+            if rect.x_min.to_pixels() < 0.0
+                || rect.y_min.to_pixels() < 0.0
+                || rect.x_max.to_pixels() as u32 > current_size.width
+                || rect.y_max.to_pixels() as u32 > current_size.height
+                || rect.x_min == rect.x_max
+                || rect.y_min == rect.y_max
+            {
+                // FIXME - throw an error when Context3D.enableErrorChecking is set
+                tracing::error!(
+                    "Invalid scissor rectangle {:?} for texture size {:?}",
+                    rect,
+                    current_size
+                );
+                self.scissor_rectangle = None;
+                None
+            } else {
+                Some([
+                    rect.x_min.to_pixels() as u32,
+                    rect.y_min.to_pixels() as u32,
+                    rect.width().to_pixels() as u32,
+                    rect.height().to_pixels() as u32,
+                ])
+            }
+        } else {
+            None
+        };
+
+        let pass = self.pending_pass.as_mut().unwrap();
+        let mut add_use = |address: usize| {
+            if !pass.uses.contains(&address) {
+                pass.uses.push(address);
+            }
+        };
+        // The same distinct buffers in the same order as `make_render_pass`
+        let mut seen: Vec<&Rc<VertexBufferWrapper>> = Vec::new();
+        for attr in self.vertex_attributes.iter().flatten() {
+            if !seen.iter().any(|b| Rc::ptr_eq(b, &attr.buffer)) {
+                seen.push(&attr.buffer);
+            }
+        }
+        let vertex_buffers: Vec<wgpu::Buffer> = seen.iter().map(|b| b.buffer.clone()).collect();
+        for b in &seen {
+            add_use(Rc::as_ptr(b) as usize);
+        }
+        add_use(index_buffer as *const IndexBufferWrapper as usize);
+        for address in self.current_pipeline.bound_texture_addresses() {
+            add_use(address);
+        }
+        crate::pmstat::add(crate::pmstat::C::Draw, 1);
+        pass.draws.push(PendingDraw {
+            draw: draw && self.compiled_pipeline.is_some() && self.bind_group.is_some(),
+            pipeline: self.compiled_pipeline.clone(),
+            bind_group: self.bind_group.clone(),
+            offsets,
+            vertex_buffers,
+            index_buffer: index_buffer.buffer.clone(),
+            indices,
+            scissor,
+            stencil_ref: self.current_pipeline.stencil_ref_value(),
+        });
+    }
