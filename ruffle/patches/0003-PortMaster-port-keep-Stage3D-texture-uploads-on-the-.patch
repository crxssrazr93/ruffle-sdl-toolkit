+
+/// Uploads a BitmapData (mip level 0). When its newest pixels are on the GPU (e.g. right after
+/// `BitmapData.draw`), copy GPU-side instead of reading them back to the CPU first.
+pub(super) fn upload_bitmap_data<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    texture: crate::avm2::object::TextureObject<'gc>,
+    source: crate::bitmap::bitmap_data::BitmapData<'gc>,
+) {
+    let dest = texture.handle();
+    if source.is_gpu_modified()
+        && source.width() <= dest.width()
+        && source.height() <= dest.height()
+    {
+        let (width, height) = (source.width(), source.height());
+        let handle = source.bitmap_handle(activation.gc(), activation.context.renderer);
+        activation.context.renderer.flush_pending_gpu_work();
+        texture
+            .context3d()
+            .copy_bitmap_handle_to_texture(handle, width, height, dest, 0);
+    } else {
+        texture.context3d().copy_bitmapdata_to_texture(
+            &source.sync(activation.context.renderer).borrow(),
+            dest,
+            0,
+        );
+    }
+}
