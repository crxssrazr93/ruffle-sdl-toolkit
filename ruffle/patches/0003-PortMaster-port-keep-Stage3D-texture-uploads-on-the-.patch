+
+/// Opt-in ActionScript 3 profiler for the PortMaster port (RUFFLE_AS3_PROF=1): every five seconds
+/// logs the methods with the most exclusive (self) time.
+mod as3prof {
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    use std::sync::OnceLock;
+    use std::time::{Duration, Instant};
+
+    pub fn enabled() -> bool {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        *ENABLED.get_or_init(|| std::env::var_os("RUFFLE_AS3_PROF").is_some())
+    }
+
+    #[derive(Default)]
+    struct Prof {
+        stack: Vec<(usize, Instant, Duration)>,
+        stats: HashMap<usize, (String, Duration, Duration, u64)>,
+        last_dump: Option<Instant>,
+    }
+
+    thread_local! {
+        static PROF: RefCell<Prof> = RefCell::new(Prof::default());
+    }
+
+    pub fn enter(id: usize, name: impl FnOnce() -> String) {
+        PROF.with_borrow_mut(|p| {
+            p.stats
+                .entry(id)
+                .or_insert_with(|| (name(), Duration::ZERO, Duration::ZERO, 0));
+            p.stack.push((id, Instant::now(), Duration::ZERO));
+        });
+    }
+
+    pub fn leave() {
+        PROF.with_borrow_mut(|p| {
+            let Some((id, start, children)) = p.stack.pop() else { return };
+            let total = start.elapsed();
+            if let Some(entry) = p.stats.get_mut(&id) {
+                entry.1 += total.saturating_sub(children);
+                entry.2 += total;
+                entry.3 += 1;
+            }
+            if let Some(parent) = p.stack.last_mut() {
+                parent.2 += total;
+            }
+            let now = Instant::now();
+            let last = *p.last_dump.get_or_insert(now);
+            if p.stack.is_empty() && now - last >= Duration::from_secs(5) {
+                let mut rows: Vec<_> = p.stats.values().filter(|r| r.3 > 0).collect();
+                rows.sort_by(|a, b| b.1.cmp(&a.1));
+                let mut out = String::from("as3prof (self ms / total ms / calls over 5 s):");
+                for (name, own, incl, calls) in rows.iter().take(45) {
+                    out.push_str(&format!(
+                        "\n  {:8.1} {:8.1} {:7} {}",
+                        own.as_secs_f64() * 1000.0,
+                        incl.as_secs_f64() * 1000.0,
+                        calls,
+                        name
+                    ));
+                }
+                tracing::info!("{out}");
+                for row in p.stats.values_mut() {
+                    row.1 = Duration::ZERO;
+                    row.2 = Duration::ZERO;
+                    row.3 = 0;
+                }
+                p.last_dump = Some(now);
+            }
+        });
+    }
+}
