+/// PortMaster port: `RUFFLE_DRAW_IN_PLACE` (default on; "0" turns it off), see `render_offscreen`.
+fn draw_in_place() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("RUFFLE_DRAW_IN_PLACE").map_or(true, |v| v != "0"))
+}
+
+/// PortMaster port: whether `commands` sample `target` (a bitmap, a shape's bitmap fill, nested
+/// lists), which rules out rendering into it in place.
+fn commands_sample(commands: &CommandList, target: &BitmapHandle) -> bool {
+    let same =
+        |handle: &BitmapHandle| std::ptr::addr_eq(Arc::as_ptr(&handle.0), Arc::as_ptr(&target.0));
+    commands.commands.iter().any(|command| match command {
+        ruffle_render::commands::Command::RenderBitmap { bitmap, .. }
+        | ruffle_render::commands::Command::RenderStage3D { bitmap, .. } => same(bitmap),
+        ruffle_render::commands::Command::RenderShape { shape, .. } => {
+            crate::mesh::as_mesh(shape).bitmaps.iter().any(same)
+        }
+        ruffle_render::commands::Command::RenderAlphaMask {
+            maskee_commands,
+            mask_commands,
+        } => commands_sample(maskee_commands, target) || commands_sample(mask_commands, target),
+        ruffle_render::commands::Command::Blend(list, _) => commands_sample(list, target),
+        _ => false,
+    })
+}
+
+/// PortMaster port: `RUFFLE_DRAW_POOL_MB` (default 16; 0 turns it off) in bytes, see
+/// `render_offscreen`.
+fn draw_pool_limit() -> u64 {
+    static LIMIT: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *LIMIT.get_or_init(|| {
+        std::env::var("RUFFLE_DRAW_POOL_MB")
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .unwrap_or(16)
+            * 1024
+            * 1024
+    })
+}
