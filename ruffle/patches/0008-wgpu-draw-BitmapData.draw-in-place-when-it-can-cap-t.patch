+    /// PortMaster port: `render_offscreen` for a single-sampled draw whose commands do not
+    /// sample `handle`. The commands are drawn straight into the bitmap's texture
+    /// (`ExistingKeep`: its content is loaded), with no pooled frame buffer of the same size,
+    /// no copy into it and no copy back.
+    fn render_offscreen_in_place(
+        &mut self,
+        handle: BitmapHandle,
+        commands: CommandList,
+        quality: StageQuality,
+        bounds: PixelRegion,
+    ) -> Box<QueueSyncHandle> {
+        let format = wgpu::TextureFormat::Rgba8Unorm;
+        let texture = as_texture(&handle);
+        let extent = wgpu::Extent3d {
+            width: texture.texture.width(),
+            height: texture.texture.height(),
+            depth_or_array_layers: 1,
+        };
+        let surface = Surface::new(
+            &self.descriptors,
+            quality,
+            extent.width,
+            extent.height,
+            format,
+        );
+        let _target = surface.draw_commands(
+            RenderTargetMode::ExistingKeep(texture.texture.clone()),
+            &self.descriptors,
+            &self.meshes,
+            commands,
+            &mut self.active_frame.staging_belt,
+            &self.dynamic_transforms,
+            &mut self.profiler.scope(
+                "Offscreen commands in place",
+                &mut self.active_frame.command_encoder,
+            ),
+            LayerRef::Current,
+            &mut self.offscreen_texture_pool,
+        );
+        self.active_frame.maybe_flush(&self.descriptors);
+        let target = TextureTarget {
+            size: extent,
+            texture: texture.texture.clone(),
+            format,
+            buffer: None,
+        };
+        self.make_queue_sync_handle(target, None, handle, bounds)
+    }
 }
 
