@@ -346,11 +387,67 @@ impl<'gc> TDisplayObject<'gc> for Graphic<'gc> {
 #[collect(require_static)]
 struct GraphicShared {
     id: CharacterId,
-    shape: swf::Shape,
+    /// The parsed shape records; parsed on demand from `tag` with lazy shape records.
+    shape: OnceCell<swf::Shape>,
+    /// PortMaster port: where to parse `shape` from (lazy shape records).
+    tag: Option<ShapeTag>,
     render_handle: Option<ShapeHandle>,
+    /// PortMaster port: `shape` is rendered (false for an empty Graphic).
+    tessellate: bool,
     shape_bounds: Rectangle<Twips>,
     edge_bounds: Rectangle<Twips>,
     movie: Arc<SwfMovie>,
     #[collect(require_static)]
     scaled_handle: RefCell<TessellationCache>,
 }
+
+/// PortMaster port: `RUFFLE_LAZY_SHAPES` (default on; "0" turns it off): DefineShape characters are
+/// tessellated when first rendered instead of at preload.
+fn lazy_shapes() -> bool {
+    static LAZY: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *LAZY.get_or_init(|| std::env::var("RUFFLE_LAZY_SHAPES").map_or(true, |v| v != "0"))
+}
+
+/// PortMaster port: the bytes of a DefineShape tag, kept to parse its records on demand.
+pub struct ShapeTag {
+    pub slice: SwfSlice,
+    /// SWF version of the movie (for the reader).
+    pub swf_version: u8,
+    /// DefineShape version (1 to 4).
+    pub version: u8,
+}
+
+impl GraphicShared {
+    /// The shape records, parsed from the tag on first use (lazy shape records).
+    fn shape(&self) -> &swf::Shape {
+        self.shape.get_or_init(|| {
+            let tag = self.tag.as_ref().expect("a lazy shape keeps its tag");
+            let mut reader = swf::read::Reader::new(tag.slice.data(), tag.swf_version);
+            match reader.read_define_shape(tag.version) {
+                Ok(shape) => shape,
+                Err(e) => {
+                    tracing::error!("Failed to parse shape {} again: {e}", self.id);
+                    swf::Shape {
+                        version: tag.version,
+                        id: self.id,
+                        shape_bounds: self.shape_bounds,
+                        edge_bounds: self.edge_bounds,
+                        flags: swf::ShapeFlag::empty(),
+                        styles: swf::ShapeStyles {
+                            fill_styles: Vec::new(),
+                            line_styles: Vec::new(),
+                        },
+                        shape: Vec::new(),
+                    }
+                }
+            }
+        })
+    }
+}
+
+/// PortMaster port: `RUFFLE_LAZY_SHAPE_RECORDS` (default on; "0" turns it off), see
+/// `Graphic::from_swf_tag`.
+fn lazy_shape_records() -> bool {
+    static LAZY: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *LAZY.get_or_init(|| std::env::var("RUFFLE_LAZY_SHAPE_RECORDS").map_or(true, |v| v != "0"))
+}
