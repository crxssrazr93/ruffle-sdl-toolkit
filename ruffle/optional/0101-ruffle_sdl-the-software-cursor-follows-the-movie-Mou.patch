+/// The pointing hand of buttons and links, fingertip on the pointer: `X` outline, `.` fill.
+const HAND: [&str; 19] = [
+    "     XX",
+    "    X..X",
+    "    X..X",
+    "    X..X",
+    "    X..X",
+    "    X..XXX",
+    "    X..X..XXX",
+    "    X..X..X..XX",
+    "XXX X..X..X..X.X",
+    "X..XX..........X",
+    "X...X..........X",
+    " X.............X",
+    "  X............X",
+    "  X...........X",
+    "   X..........X",
+    "   X.........X",
+    "    X........X",
+    "    X........X",
+    "    XXXXXXXXXX",
+];
+
+/// `HAND` at `size` pixels high, box filtered (4x4 samples per pixel) so it matches the arrow.
+fn hand(size: u32) -> Bitmap {
+    let (gw, gh) = (16.0f32, HAND.len() as f32);
+    let scale = size as f32 / gh;
+    let width = (gw * scale).ceil() as u32;
+    let n = 4;
+    let mut rgba = vec![0u8; (width * size * 4) as usize];
+    for py in 0..size {
+        for px in 0..width {
+            let (mut white, mut black) = (0u32, 0u32);
+            for sy in 0..n {
+                for sx in 0..n {
+                    let gx = (px as f32 + (sx as f32 + 0.5) / n as f32) / scale;
+                    let gy = (py as f32 + (sy as f32 + 0.5) / n as f32) / scale;
+                    match HAND
+                        .get(gy as usize)
+                        .and_then(|row| row.as_bytes().get(gx as usize))
+                    {
+                        Some(b'X') => black += 1,
+                        Some(b'.') => white += 1,
+                        _ => {}
+                    }
+                }
+            }
+            let covered = white + black;
+            if covered == 0 {
+                continue;
+            }
+            let v = (white * 255 / covered) as u8;
+            let a = (covered * 255 / (n * n)) as u8;
+            let i = ((py * width + px) * 4) as usize;
+            rgba[i..i + 4].copy_from_slice(&[v, v, v, a]);
+        }
+    }
+    Bitmap {
+        width,
+        height: size,
+        rgba,
+        hot: ((5.5 * scale) as i32, 0),
+    }
+}
